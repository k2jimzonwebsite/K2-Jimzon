# ==============================================================================
# K2 JIMZON ENTERPRISE PRODUCTION ENVIRONMENT VARIABLES MATRIX
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Build Flag (Server / Vercel Environment Only)
# Do NOT prefix with VITE_. Used by Vercel deployment targets.
# ------------------------------------------------------------------------------
# Storefront Vercel Project: K2_DEPLOYMENT_TARGET=storefront
# Admin BOS Vercel Project:  K2_DEPLOYMENT_TARGET=admin
K2_DEPLOYMENT_TARGET=storefront
# Independent server route switches. Keep false until matching migrations,
# secrets, origins, preview denials, and browser flags pass the cutover gate.
K2_ADMIN_BFF_ENABLED=false
K2_STOREFRONT_BFF_ENABLED=false

# Optional build target flag for local Vite dev server
VITE_IS_ADMIN_DEPLOYMENT=false
# Keep false until all Admin BOS data capabilities have named BFF routes and the
# coordinated cookie-session activation checklist passes on the preview host.
VITE_ADMIN_BFF_ENABLED=false
# Public storefront origin used only by the Admin BOS "View storefront" action.
VITE_STOREFRONT_URL=https://shop.example.com

# ------------------------------------------------------------------------------
# 2. Client-Exposed Supabase Public Configuration (VITE_ Prefixed)
# SAFE FOR BROWSER DELIVERY. These values are bundled into client JS code.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://pixplcjqivlfflickobf.supabase.co
# Preferred modern browser-safe key. The build also accepts the server-side
# SUPABASE_PUBLISHABLE_KEY name and exposes only that public value to the client.
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
# Keep false until the signed database boundary, BFF environment, and Turnstile
# forms are deployed and the coordinated cutover checklist is ready. The public
# site key is required independently in each Storefront/Admin project that uses it.
VITE_GUEST_BFF_ENABLED=false
VITE_CUSTOMER_ACCOUNT_ENABLED=false
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# ------------------------------------------------------------------------------
# 3. Server-Only Secrets (NO VITE_ PREFIX - NEVER DELIVER TO BROWSER)
# Stored strictly in Supabase Edge Function Secrets or Vercel Server Envs.
# WARNING: Prefixing any secret with VITE_ leaks it into public browser JS.
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
SUPABASE_SECRET_KEY=your-supabase-secret-key-here
ENCRYPTION_SECRET=generate-a-unique-random-secret-outside-the-repository

# Admin BOS same-origin BFF only. Generate a unique 32-byte value and store its
# base64 representation in the Admin Vercel project; never reuse it elsewhere.
K2_SESSION_COOKIE_KEY=base64-of-32-random-bytes
# Independent 32-byte HMAC key for signed Admin BOS commands. Its decoded bytes
# must match the private database secret installed during approved cutover.
K2_ADMIN_BFF_REQUEST_SECRET=base64-of-another-32-random-bytes
# Comma-separated exact origins; no paths, globs, or wildcard origins.
K2_ADMIN_ORIGINS=https://admin.example.com
# Independent staff password-recovery gate. Keep false until the private durable
# pre-auth rate migration, exact provider redirect/template, and real
# single-use/global-revocation/provider-suppression journey pass.
K2_ADMIN_PASSWORD_RECOVERY_ENABLED=false
K2_ADMIN_PASSWORD_RECOVERY_CALLBACK_URL=https://admin.example.com/api/admin/auth/password-recovery/verify
# Local HTTP only. Production always forces Secure cookies regardless.
K2_COOKIE_SECURE=false

# Storefront same-origin guest BFF only. Use an independent 32-byte random value
# encoded as base64. Its decoded bytes must match the private database request
# secret configured during the coordinated guest-boundary activation.
K2_GUEST_BFF_SECRET=base64-of-32-random-bytes
K2_STOREFRONT_ORIGINS=https://shop.example.com
# Cloudflare Turnstile secret; required independently by protected Storefront
# forms and secure Admin login/recovery issuance in their separate projects.
K2_TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# OAuth Provider Secrets (Server / Edge Functions Only)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Business Messaging Credentials (Edge Functions Only)
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-permanent-token
VIBER_BOT_TOKEN=your-viber-bot-token

# Omnichannel Marketplace Credentials (Edge Functions Only)
SHOPEE_PARTNER_ID=your-shopee-partner-id
SHOPEE_PARTNER_KEY=your-shopee-partner-secret-key
SHOPEE_PUSH_MAX_AGE_SECONDS=confirm-from-approved-shopee-contract
SHOPEE_BODY_READ_TIMEOUT_MS=confirm-before-shopee-activation-1-to-30000
LAZADA_APP_KEY=your-lazada-app-key
LAZADA_APP_SECRET=your-lazada-app-secret
TIKTOK_APP_KEY=your-tiktok-app-key
TIKTOK_APP_SECRET=your-tiktok-app-secret

# AI & LLM Engine Keys (Edge Functions Only)
GEMINI_API_KEY=your-google-gemini-api-key
