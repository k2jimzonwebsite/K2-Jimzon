  "query": "select current_user as query_role,current_setting('server_version_num') as server_version_num,current_setting('transaction_read_only') as transaction_read_only,r.rolsuper as installer_superuser,r.rolcreaterole as installer_createrole,c.name,pg_get_userbyid(pc.relowner) as owner,has_table_privilege('postgres',c.name,'SELECT') as can_select,has_table_privilege('postgres',c.name,'INSERT') as can_insert,has_table_privilege('postgres',c.name,'UPDATE') as can_update,has_table_privilege('postgres',c.name,'DELETE') as can_delete,has_table_privilege('postgres',c.name,'TRUNCATE') as can_truncate,has_table_privilege('postgres',c.name,'MAINTAIN') as can_maintain from (values ('pg_catalog.pg_class'),('pg_catalog.pg_attribute'),('pg_catalog.pg_proc'),('pg_catalog.pg_authid'),('pg_catalog.pg_auth_members'),('pg_catalog.pg_parameter_acl'),('pg_catalog.pg_db_role_setting'),('pg_catalog.pg_event_trigger')) as c(name) join pg_catalog.pg_class pc on pc.oid=to_regclass(c.name) cross join pg_catalog.pg_roles r where r.rolname='postgres' order by c.name",
