{
  "name": "k2-jimzon-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --mode admin --port 5174",
    "dev:storefront": "vite --mode storefront --port 5173",
    "build": "vite build && node scripts/verify-build-boundary.mjs auto && node scripts/scan-secrets.mjs dist",
    "build:storefront": "vite build --mode storefront && node scripts/verify-build-boundary.mjs storefront && node scripts/scan-secrets.mjs dist",
    "build:admin": "vite build --mode admin && node scripts/verify-build-boundary.mjs admin && node scripts/scan-secrets.mjs dist",
    "preview": "vite preview",
    "check:imports": "node scripts/check-imports.mjs",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "security:history": "node scripts/scan-git-history-secrets.mjs",
    "security:bundle": "node scripts/scan-secrets.mjs dist",
    "security:test": "node scripts/test-secret-scan.mjs",
    "verify:map017-boundary": "node scripts/verify-map017-public-boundary.mjs",
    "verify:map018-intake": "node scripts/verify-map018-intake-contract.mjs",
    "verify:admin-bff": "node scripts/verify-admin-bff.mjs",
    "verify:map019-identity": "node scripts/verify-map019-identity.mjs",
    "verify:guest-bff": "node scripts/verify-guest-bff.mjs",
    "test:contracts": "playwright test --config=playwright.api.config.js tests/guest-commerce-bff-contract.spec.js tests/admin-bff-contract.spec.js tests/product-intake-contract.spec.js tests/admin-logic-regressions.spec.js",
    "prebuild": "npm run security:secrets && node scripts/check-imports.mjs",
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke.spec.js",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "^2.110.7",
    "@svg-maps/world": "^2.0.0",
    "dotenv": "^17.4.2",
    "html5-qrcode": "^2.3.8",
    "motion": "^12.42.2",
    "papaparse": "^5.5.4",
    "react": "^19.1.0",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.1.0",
    "react-helmet-async": "^3.0.0",
    "sharp": "^0.35.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-react": "^4.6.0",
    "playwright": "^1.61.1",
    "puppeteer": "^25.3.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.3.5"
  }
}
